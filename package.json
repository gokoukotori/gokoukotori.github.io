{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gallery:validate && vite build",
    "preview": "vite preview",
    "gallery:thumbnails": "node scripts/prepare-r2-thumbnails.mjs",
    "test": "node --test scripts/*.test.mjs",
    "gallery:manifest": "node scripts/generate-gallery-manifest.mjs",
    "gallery:validate": "node scripts/validate-gallery-manifest.mjs",
    "gallery:validate:local": "node scripts/validate-gallery-manifest.mjs --local",
    "gallery:r2:check": "node --env-file-if-exists=.env.r2.local scripts/upload-r2-gallery.mjs",
    "gallery:r2:upload": "node --env-file-if-exists=.env.r2.local scripts/upload-r2-gallery.mjs --apply"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "flowbite": "^3.1.2",
    "flowbite-svelte": "^1.27.0",
    "flowbite-svelte-icons": "^3.0.0",
    "sharp": "^0.35.3",
    "svelte": "^5.43.5",
    "tailwindcss": "^4.1.14",
    "vite": "^7.2.2"
  }
}
